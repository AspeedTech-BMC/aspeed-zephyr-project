# The vendor A2 board enables IPM for its BootMCU IPC nodes.
configdefault IPM
	default y if DT_HAS_ASPEED_BOOTMCU_IPC_ENABLED

if IPM

config IPM_BOOTMCU
	bool "ASPEED IPC driver"
	default y
	depends on DT_HAS_ASPEED_BOOTMCU_IPC_ENABLED
	help
	  Enable the IPC driver for ASPEED BootMCU.

endif # IPM
