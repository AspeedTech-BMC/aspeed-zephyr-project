config CPTRA_UPDATE
	bool "ASPEED CPTRA Update driver"
	default y
	depends on SOC_AST2700_BOOTMCU && DT_HAS_ASPEED_CPTRA_UPDATE_ENABLED
	help
	  This option enables the Caliptra update driver for ASPEED SoCs.

config CPTRA_IFC
	bool "ASPEED CPTRA IFC driver"
	default y
	depends on SOC_AST2700_BOOTMCU && DT_HAS_ASPEED_CPTRA_IFC_ENABLED
	help
	  This option enables the Caliptra ifc driver for ASPEED SoCs.

config CPTRA_MBOX
	bool "ASPEED CPTRA MBOX driver"
	default y
	depends on SOC_AST2700_BOOTMCU && DT_HAS_ASPEED_CPTRA_MBOX_ENABLED
	help
	  This option enables the Caliptra mbox driver for ASPEED SoCs.

config CPTRA_DICE
	bool "ASPEED CPTRA DICE driver"
	default y
	depends on SOC_AST2700_BOOTMCU && DT_HAS_ASPEED_CPTRA_DICE_ENABLED
	help
	  This option enables the Caliptra dice driver for ASPEED SoCs.

config CPTRA_MISC
	bool "ASPEED CPTRA MISC driver"
	default y
	depends on SOC_AST2700_BOOTMCU && DT_HAS_ASPEED_CPTRA_MISC_ENABLED
	help
	  This option enables the Caliptra misc driver for ASPEED SoCs.

config CPTRA_IPC
	bool "ASPEED CPTRA IPC driver"
	default y
	depends on SOC_AST2700_BOOTMCU && IPM_BOOTMCU
	depends on CPTRA_ECDSA && CPTRA_SHA && CPTRA_LMS
	depends on CPTRA_UPDATE && CPTRA_DICE && CPTRA_MISC
	help
	  This option enables the Caliptra ipc driver for ASPEED SoCs.

if CPTRA_IPC
module = MISC_ASPEED
module-str = misc-aspeed
source "subsys/logging/Kconfig.template.log_config"
endif

config OTP_AST27XX
	bool "ASPEED AST27XX OTP"
	default y
	depends on DT_HAS_ASPEED_AST27XX_OTP_ENABLED
	help
	  Enable the OTP utility for ASPEED AST27XX SoCs.

config OTP_IPC
	bool "ASPEED OTP IPC driver"
	default y
	depends on SOC_AST2700_BOOTMCU && IPM_BOOTMCU && OTP_AST27XX
	help
	  Let the SSP and the Cortex-A35 read and program the OTP over the
	  BootMCU IPC mailbox, on a command channel of its own.

config PRIVILEGE_CTRL
	bool "Enable ASPEED privilege control"
	default y
	depends on SOC_AST2700_BOOTMCU && DT_HAS_ASPEED_PRICTRL_ENABLED
	help
	  This option enables privilege control for aspeed
	  board isolation.

config EDAF_BRIDGE_ASPEED
	bool "Enable ASPEED eDAF bridge controller"
	default y
	depends on SOC_AST2700_BOOTMCU && DT_HAS_ASPEED_EDAF_BRIDGE_ENABLED
	help
	  This option enables the eDAF bridge controller
	  for ASPEED SoCs.
