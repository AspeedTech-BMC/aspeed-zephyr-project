CONFIG_SYS_CLOCK_HW_CYCLES_PER_SEC=400000000
CONFIG_SYS_CLOCK_TICKS_PER_SEC=100000
CONFIG_MAIN_STACK_SIZE=4096
CONFIG_BOOTLOADER_SRAM_SIZE=0
CONFIG_HWINFO=y
CONFIG_CONSOLE=y
CONFIG_UART_CONSOLE=y
CONFIG_SERIAL=y
CONFIG_UART_NS16550=y
CONFIG_HEAP_MEM_POOL_SIZE=50000
CONFIG_CLOCK_CONTROL=y
CONFIG_RESET=y
CONFIG_PINCTRL=y
CONFIG_ASSERT=y
# For CMSIS
CONFIG_POLL=y
CONFIG_GPIO=y
CONFIG_GPIO_SHELL=y
# AST1080 (G2) uses the g7 GPIO driver, auto-enabled via devicetree
# (CONFIG_GPIO_ASPEED_G7 / DT_HAS_ASPEED_G7_GPIO_ENABLED).
CONFIG_THREAD_NAME=y
CONFIG_THREAD_STACK_INFO=y
CONFIG_THREAD_MONITOR=y
CONFIG_INIT_STACKS=y
CONFIG_NUM_PREEMPT_PRIORITIES=56
CONFIG_CMSIS_RTOS_V2=y
CONFIG_COMMON_LIBC_MALLOC_ARENA_SIZE=8192
CONFIG_SHELL_STACK_SIZE=4096
CONFIG_CMSIS_V2_EVT_FLAGS_MAX_COUNT=64
