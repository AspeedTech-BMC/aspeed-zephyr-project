config HROT_WRAPPER
	default n
	bool "Hardware root of trust wrapper layer"

choice HROT_HASH_BACKEND
	depends on HROT_WRAPPER
	prompt "HROT hash backend"
	default HROT_HASH_BACKEND_ASPEED if CRYPTO_ASPEED
	default HROT_HASH_BACKEND_CPTRA if CPTRA_MCI_SHA_ACC
	default HROT_HASH_BACKEND_MBEDTLS if MBEDTLS
	help
	  Select the backend used by the HROT hash wrapper.

config HROT_HASH_BACKEND_ASPEED
	bool "ASPEED hardware hash"
	depends on CRYPTO_ASPEED
	help
	  Use the ASPEED Zephyr crypto driver through the HROT HAL.

config HROT_HASH_BACKEND_MBEDTLS
	bool "mbedTLS software hash"
	depends on MBEDTLS
	select MBEDTLS_SHA256
	select MBEDTLS_SHA384
	help
	  Use mbedTLS software SHA-256/SHA-384 through the HROT hash wrapper.

config HROT_HASH_BACKEND_CPTRA
	bool "Caliptra-SS MCI SHA_ACC hardware hash"
	depends on CPTRA_MCI_SHA_ACC
	help
	  Use the Caliptra-SS MCI SHA_ACC engine, which DMA-reads the source
	  instead of copying it through the mailbox. SHA-256 is unsupported;
	  calculate_sha256/start_sha256 always fail.

endchoice

