#include <zephyr/dt-bindings/gpio/gpio.h>

&i2cfilter {
	status = "okay";
};

&mbxctrl {
	status = "okay";
};

&i2c0 {
	status = "okay";

	swmbx0: swmbx0@38 {
		compatible = "aspeed,swmbx-dev";
		reg = <0x38>;
		size = <256>;
		port = <0>;
		status = "okay";
	};
};

&i2c1 {
	status = "okay";
};

&i2c2 {
	status = "okay";

	swmbx1: swmbx1@70 {
		compatible = "aspeed,swmbx-dev";
		reg = <0x70>;
		size = <256>;
		port = <1>;
		status = "okay";
	};
};

&i2c4 {
	status = "okay";
};

&i2c5 {
	status = "okay";
};

&i2c6 {
	status = "okay";
};

&i2c7 {
	status = "okay";
};

// for i2c filter testing
&i2c8 {
	status = "okay";
};

&sgpiom {
	status = "okay";
	sgpiom_a_d {
		status = "okay";
	};
	sgpiom_e_h {
		status = "okay";
	};
	sgpiom_i_l {
		status = "okay";
	};
	sgpiom_m_p {
		status = "okay";
	};
};

/ {
	pfr_gpio_common {
		compatible = "aspeed,pfr-gpio-common";
		bmc-srst-ctrl-out-gpios = <&sgpiom_a_d 8 0>; /* SGPIO OUT #9 */
		bmc-extrst-ctrl-out-gpios = <&sgpiom_a_d 9 0>; /* SGPIO OUT #10 */
		bmc-rst-ind-in-gpios = <&sgpiom_a_d 4 0>; /* SGPIO IN #5 */
		pch-rst-ctrl-out-gpios = <&sgpiom_a_d 10 0>; /* SGPIO OUT #11 */

		platform-state-out-gpios =
			<&sgpiom_m_p 24 0>, <&sgpiom_m_p 25 0>,
			<&sgpiom_m_p 26 0>, <&sgpiom_m_p 27 0>,
			<&sgpiom_m_p 28 0>, <&sgpiom_m_p 29 0>,
			<&sgpiom_m_p 30 0>, <&sgpiom_m_p 31 0>;

		/* NOTICE:
		 * Normally, these two pin should be GPIO_ACTIVE_LOW, but currently this EVB
		 * doesn't produce correct power sequence by itself.
		 */
		rst-srst-bmc-in-gpios = <&sgpiom_a_d 1 GPIO_ACTIVE_HIGH>; /* SGPIO IN #2 */
		rst-rsmrst-in-gpios = <&sgpiom_a_d 0 GPIO_ACTIVE_HIGH>; /* SGPIO IN #1 */
	};

	pfr_gpio_mp {
		compatible = "aspeed,pfr-gpio-mp";
		mp-status1-out-gpios = <&gpio0_i_l 24 0>; /* GPIO_L0 */
		mp-status2-out-gpios = <&gpio0_i_l 2 0>;  /* GPIO_I2 */
	};
};

&wdt0 {
	status = "okay";
};

&wdt1 {
	status = "okay";
};

&wdt2 {
	status = "okay";
};

&wdt3 {
	status = "okay";
};

&wdt4 {
	status = "okay";
};

&fmc {
	status = "okay";
};

&fmc_cs0 {
	/delete-property/ broken-sfdp;
	/delete-property/ write-block-size;
	status = "okay";
	spi-max-buswidth = <4>;
	spi-max-frequency = <50000000>;
	partitions {
		compatible = "fixed-partitions";
		#address-cells = <1>;
		#size-cells = <1>;
		mcuboot_partition: partition@0 {
			label = "mcuboot";
			reg = <0x0 0x1c000>;
		};

		certificate_partition: partition@1c000 {
			label = "certificate";
			reg = <0x1c000 0x4000>;
		};


		active_partition: partition@20000 {
			label = "active";
			reg = <0x20000 0x60000>;
		};

		recovery_partition: partition@80000 {
			label = "recovery";
			reg = <0x80000 0x60000>;
		};

		otp_img_partition: partition@e0000 {
			label = "otp_img";
			reg = <0xe0000 0x1c000>;
		};
	};
};

&fmc_cs1 {
	status = "okay";
	spi-max-buswidth = <4>;
	spi-max-frequency = <50000000>;
};

&spi1 {
	num-cs = <1>;
	status = "okay";
};

/* "SPI1_CS0" is used to access flash connected to SPI_Monitor_1,
 * "SPI2_CS0" is used to access flash connected to SPI_Monitor_3,
 * "SPI2_CS1" is used to access flash connected to SPI_Monitor_4,
 */

&spi1_cs0 {
	spi-max-buswidth = <4>;
	spi-max-frequency = <50000000>;
	spi-monitor-ctrl = <&spim1>;
	status = "okay";
};

&spi2_cs0 {
	spi-max-buswidth = <1>;
	spi-max-frequency = <50000000>;
	spi-monitor-ctrl = <&spim3>;
	status = "okay";
};

&spi2_cs1 {
	spi-max-buswidth = <1>;
	spi-max-frequency = <50000000>;
	spi-monitor-ctrl = <&spim4>;
	status = "okay";
};

&spi2 {
	internal-mux-master = <2>;
	spi-monitor-output-base = <3>;
	spi-monitor-common-ctrl = <&spim0>;
	pinctrl-0 = <>;

	num-cs = <2>;
	status = "okay";

	spim-proprietary-config-enable;
};

&spim0 {
	status = "okay";
};

&spim1 {
	allow-cmds = [03 13 0b 0c 6b 6c 01 05 35 06 04 20 21 9f 5a b7 e9 32 34 d8 dc 02 12 3b 3c 70 bb bc 50 eb ec c2];
	log-ram-size = <0x200>;
	pinctrl-0 = <pinctrl_spim1_quad_default>;
	pinctrl-names = "default";
	ext-mux-sel = <1>;
	status = "okay";
};

&spim3 {
	allow-cmds = [03 13 0b 0c 6b 6c 01 05 35 06 04 20 21 9f 5a b7 e9 32 34 d8 dc 02 12 3b 3c 70 bb bc 50 eb ec c2];
	log-ram-size = <0x200>;
	pinctrl-0 = <&pin_spim3csin &pin_spim3clkin &pin_spim3mosiin &pin_spim3misoin
		&pin_spim3csout &pin_spim3io2in &pin_spim3io3in &pin_spim3clkout
		&pin_spim3misoout &pin_spim3mosiout &pin_spim3io2out &pin_spim3io3out
		&pin_spim3muxsel>;
	pinctrl-names = "default";
	ext-mux-sel = <1>;
	status = "okay";
};

&spim4 {
	allow-cmds = [03 13 0b 0c 6b 6c 01 05 35 06 04 20 21 9f 5a b7 e9 32 34 d8 dc 02 12 3b 3c 70 bb bc 50 eb ec c2];
	log-ram-size = <0x200>;
	pinctrl-0 = <&pin_spim4csin &pin_spim4clkin &pin_spim4mosiin &pin_spim4misoin
		&pin_spim4csout &pin_spim4io2in &pin_spim4io3in &pin_spim4clkout
		&pin_spim4misoout &pin_spim4mosiout &pin_spim4io2out &pin_spim4io3out
		&pin_spim4muxsel>;
	pinctrl-names = "default";
	ext-mux-sel = <1>;
	status = "okay";
};

&hace {
	status = "okay";
};

&rsa {
	status = "okay";
};

&ecdsa {
	status = "okay";
};
