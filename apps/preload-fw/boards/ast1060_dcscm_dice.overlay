#include "ast1060_dcscm_gpio_common.dts"
#include "ast1060_dcscm_gpio_mp.dts"

&wdt0 {
	status = "okay";
};

&wdt1 {
	status = "okay";
};

&wdt2 {
	status = "okay";
};

&wdt3 {
	status = "okay";
};

&wdt4 {
	status = "okay";
};

&fmc {
	status = "okay";
};

&fmc_cs0 {
	/delete-property/ broken-sfdp;
	/delete-property/ write-block-size;
	status = "okay";
	spi-max-buswidth = <4>;
	spi-max-frequency = <50000000>;
	partitions {
		compatible = "fixed-partitions";
		#address-cells = <1>;
		#size-cells = <1>;
		mcuboot_partition: partition@0 {
			label = "mcuboot";
			reg = <0x0 0x1c000>;
		};

		certificate_partition: partition@1c000 {
			label = "certificate";
			reg = <0x1c000 0x4000>;
		};


		active_partition: partition@20000 {
			label = "active";
			reg = <0x20000 0x60000>;
		};

		recovery_partition: partition@80000 {
			label = "recovery";
			reg = <0x80000 0x60000>;
		};

		otp_img_partition: partition@e0000 {
			label = "otp_img";
			reg = <0xe0000 0x1c000>;
		};
	};
};

&hace {
	status = "okay";
};

&rsa {
	status = "okay";
};

&ecdsa {
	status = "okay";
};
