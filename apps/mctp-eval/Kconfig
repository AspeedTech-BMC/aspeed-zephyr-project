menu "MCTP eval"

config MCTP_EVAL_LOCAL_EID
	int "Local MCTP endpoint ID"
	range 0 254
	default 0
	help
	  EID the endpoint starts with. 0 (the null EID) leaves it unassigned
	  until the bus owner sets one with the Set Endpoint ID control
	  command. Otherwise 8..254: DSP0236 reserves 1-7, and the build
	  rejects them.

config MCTP_EVAL_USB
	bool "MCTP over USB endpoint"
	depends on MCTP_USB
	default y
	help
	  Also expose the endpoint over USB (DSP0283) on zephyr_udc0, with its
	  own libmctp instance.

if MCTP_EVAL_USB

config MCTP_EVAL_USB_VID
	hex "USB vendor ID"
	default 0x2fe3
	help
	  0x2fe3 is the Zephyr project's VID, for development and testing only.

config MCTP_EVAL_USB_PID
	hex "USB product ID"
	default 0x0100

endif # MCTP_EVAL_USB

config MCTP_EVAL_PLDM
	bool "PLDM responder (types 0 and 5)"
	depends on PLDM_RESPONDER
	default y
	help
	  Answer PLDM over MCTP on every bus with libpldm's control (type 0)
	  and firmware device (type 5) responders. Firmware updates are
	  programmed into flash (MCTP_EVAL_PLDM_FLASH) or go to a sink.

if MCTP_EVAL_PLDM

config MCTP_EVAL_PLDM_UUID
	string "Firmware device UUID descriptor"
	default "a3f1c2d4-1080-4e6a-9b30-6d6374706576"
	help
	  The UUID descriptor QueryDeviceIdentifiers reports. A firmware
	  update package must list it for the update agent to pick this
	  device.

config MCTP_EVAL_PLDM_VERSION
	string "Firmware component version"
	default "1.0"
	help
	  Appended to "mctp-eval <board>" to form the active component
	  version GetFirmwareParameters reports.

config MCTP_EVAL_PLDM_FLASH
	bool "Program updates into flash"
	select FLASH
	select FLASH_MAP
	help
	  Write the component image into the fixed partition labelled
	  pldm_update_partition and verify it by reading it back. If the
	  board also defines pldm_staging_partition, the image downloads
	  there and is copied into pldm_update_partition at apply, once it
	  has verified. Without it, updates only go to a sink that counts
	  and CRC32s the image.
	  Nothing authenticates the update agent, so any MCTP peer on any
	  bus can write the partition: turn it on only where the boot
	  authenticates what it loads from there, or on a development
	  board.

config MCTP_EVAL_PLDM_UNSAFE_COMPONENTS
	bool "Also offer the SSMCU XIP ROM and IDevID certificates for update"
	depends on MCTP_EVAL_PLDM_FLASH
	help
	  Report components 0x0002 (pldm_rom_partition, the SSMCU XIP ROM)
	  and 0x0003 (pldm_cert_partition, the IDevID certificate store)
	  too, where the board defines them. Nothing authenticates either
	  the update agent or these images: any MCTP peer on any bus can
	  replace the ROM, and a ROM left half written doesn't boot, or
	  substitute the device identity. For provisioning development
	  boards only.

config MCTP_EVAL_PLDM_REBOOT
	bool "Reboot on ActivateFirmware"
	depends on MCTP_EVAL_PLDM_FLASH
	select REBOOT
	help
	  Cold-reboot shortly after a successful ActivateFirmware, so the
	  device boots the image just programmed.

config MCTP_EVAL_PLDM_TRANSFER_SIZE
	int "Largest firmware data chunk to request"
	range 32 1019
	default 512
	help
	  Upper bound on RequestFirmwareData lengths; the update agent's
	  own maximum applies too. A chunk and its 5 bytes of MCTP type,
	  PLDM header and completion code must fit
	  CONFIG_MCTP_MAX_MESSAGE_SIZE.

endif # MCTP_EVAL_PLDM

config MCTP_EVAL_SPDM_BRIDGE
	bool "SPDM bridge to the SSMCU"
	depends on IPM
	default y if $(dt_nodelabel_enabled,ipc0_cm4_ssmcu)
	help
	  Forward SPDM requests (MCTP message type 0x05) from every bus to the
	  SSMCU's SPDM responder over the PSP IPC channel (ipc0_cm4_ssmcu doorbells,
	  bodies in its shmem_ch0 window), and send its responses back.

config MCTP_EVAL_SPDM_TIMEOUT_MS
	int "SPDM response timeout (ms)"
	depends on MCTP_EVAL_SPDM_BRIDGE
	default 5000
	help
	  How long to wait for the SSMCU's response before dropping the
	  request. It must cover the slowest SPDM operation the SSMCU does,
	  such as signing measurements.

config MCTP_EVAL_SPDM_ACK_TIMEOUT_MS
	int "SSMCU acknowledgement timeout (ms)"
	depends on MCTP_EVAL_SPDM_BRIDGE
	range 1 1000
	default 50
	help
	  How long to wait for the SSMCU to acknowledge a request (or a
	  SYNC), which it does once it has copied the request out of the
	  shared window. Without one, the bridge leaves the request buffer
	  alone and resynchronizes the channel before its next request.

endmenu

source "Kconfig.zephyr"
