 *
 * AST1030 EVB: i3c0 as an MCTP-over-I3C target. The app finds the queue by
 * the i3c0_tmq label.
 */

/ {
	chosen {
		/*
		 * The board points this at an app-defined FMC partition; this app
		 * runs from SRAM (no XIP) and doesn't use flash, so drop it.
		 */
		/delete-property/ zephyr,code-partition;
	};
};

&i3c0 {
	status = "okay";
	/* DSP0233: MCTP over I3C devices report DCR 0xCC */
	dcr = <0xcc>;
	secondary;

	/*
	 * The controller builds the PID itself: ASPEED MIPI ID 0x7ec, the SoC
	 * revision as part ID (0x8001 on A1) and the controller index as
	 * instance ID, so i3c0 reads 7ec80010000.
	 */
	i3c0_tmq: i3c-tmq@7ec80010000 {
		compatible = "i3c-target-mqueue";
		reg = <0x0 0x7ec 0x80010000>;
		/*
		 * Packets stay at the baseline 69 bytes (with PEC) unless
		 * CONFIG_MCTP_I3C_TMQ_LARGE_PACKETS lets them use all of this
		 */
		msg-size = <128>;
		/*
		 * Must be a power of two; one slot stays empty, so 32 holds 31
		 * packets: a whole CONFIG_MCTP_MAX_MESSAGE_SIZE (1024-byte)
		 * message in 64-byte-payload packets.
		 */
		num-of-msgs = <32>;
		mandatory-data-byte = <0xae>;
		/* MCTP pending-read IBI carries the MDB only; packet PEC is
		 * handled by the libmctp binding (CONFIG_MCTP_I3C_TMQ_PEC)
		 */
		ibi-append-pec = <0>;
		status = "okay";
	};
};

/*
 * USB device controller, for MCTP over USB on the new USB device stack
 * (udc_aspeed). The board labels it zephyr_udc0.
 */
&udc {
	status = "okay";
};
