config BMC_STAGING_SIZE
	default 0x03DE0000
	hex "BMC staging region size in BMC flash"
	help
	  The max size of BMC staging area for putting signed BMC capsule.

config BMC_PFR_STAGING_SIZE
	default 0x100000
	hex "PFR staging region size in BMC flash"
	help
	  The max size of PFR staging area for putting signed ROT capsule.

config BMC_CPLD_STAGING_SIZE
	default 0x400000
	hex "Platform CPLD staging region size in BMC flash"
	help
	  The max size of platform CPLD staging area for putting signed CPLD capsule.

config PCH_STAGING_SIZE
	default 0x1000000
	hex "PCH staging region size in PCH flash"
	help
	  The max size of PCH staging area for putting signed PCH capsule.

config BMC_PFR_STAGING_OFFSET
	default 0xbde0000
	hex "PFR staging region offset in BMC flash"
	help
	  The starting offset of PFR staging region, and this is also for Cerberus PFR provisioning.

config INIT_POWER_SEQUENCE
	default n
	bool "Wait for CPLD power sequence to start PFR functionality"
	help
	  PFR state machine will stay in INIT state until CPLD power sequence releases
	  RST_SRST_BMC_N and RST_RSMRST_N.

config SEAMLESS_UPDATE
	depends on INTEL_PFR
	depends on !CERBERUS_PFR
	default n
	bool "Seamless update support"
	help
	  Support FVM verification and host firmware update by seamless capsule.
	  PFR will update host firmware without going to t-1 state and rebooting host.

config PIT_PROTECTION
	depends on INTEL_PFR
	depends on !CERBERUS_PFR
	default n
	bool "PIT protection support"
	help
	  Enable PIT protection functions and PIT mailbox commands.
	  ROT will perform PIT check if PIT protection is enabled via mailbox command.

config PFR_SW_MAILBOX
	default n
	bool "SW mailbox solution"
	help
	  Enable SW mailbox support.

config KEY_MANIFEST_MAX_COUNT
	depends on CERBERUS_PFR
	default 0x10
	hex "Key manifest max count"
	help
	  The max count of key manifest for Cerberus PFR.

config LMS_SIGN_SERIAL_OFFSET
	default 4
	int "LMS Public key and Signature have the serial number or not"
	help
	  If there is no serial number, to set it to 0. Otherwise, to set it to 4.

choice PFR_ECDSA_P384_BACKEND
	depends on INTEL_PFR
	prompt "PFR P-384 ECDSA backend"
	default PFR_ECDSA_P384_BACKEND_ASPEED if ECDSA_ASPEED
	default PFR_ECDSA_P384_BACKEND_MBEDTLS if MBEDTLS
	help
	  Select the backend used for Intel PFR P-384 ECDSA verification.
	  P-256 verification uses the existing mbedTLS path.

config PFR_ECDSA_P384_BACKEND_ASPEED
	bool "ASPEED hardware ECDSA"
	depends on ECDSA_ASPEED
	help
	  Use the ASPEED ECDSA hardware driver for P-384 signature verification.

config PFR_ECDSA_P384_BACKEND_MBEDTLS
	bool "mbedTLS software ECDSA"
	depends on MBEDTLS && MBEDTLS_ECDSA_C && MBEDTLS_ECP_C
	select MBEDTLS_ECP_DP_SECP384R1_ENABLED
	help
	  Use mbedTLS software ECDSA for P-384 signature verification.

endchoice

config OTP_SIM
	depends on !OTP_ASPEED
	default n
	bool "Simulate OTP"
	help
	  Enable using flash to simulate OTP memory

config OTP_SIM_SHELL
	depends on OTP_SIM
	default n
	bool "OTP shell commands"
	help
	  Enable OTP commands for read otp data from flash

config OTP_KEY_ADD
	default n
	bool "Add new key in OTP"
	help
	  Add new pub key in OTP region for owner transfer

config OTP_KEY_RETIRE
	depends on !OTP_KEY_ADD
	default n
	bool "Retire key in OTP"
	help
	  Retire previous key after new owner's key is added in OTP.

config SECURE_LOCK_MODE
	default 0
	int "lock mode for secure connection, 0:disbale, 1:loose mode, 2:restrict mode"
	help
	  loose mode means to block the non-secure connection when provision mode is locked, restrict mode means to block the non-secure connection when provision data is presented

rsource "Kconfig.spdm"
rsource "Kconfig.rsu"

config PFR_DEBUG_SHELL
	bool "Enable debug shell for development"
	select SHELL
	select FLASH_SHELL
	select GPIO_SHELL
	select HWINFO_SHELL
	# Only pull in the SPI-monitor shell when the SPI-monitor driver is
	# available.
	select SPI_MONITOR_SHELL_ASPEED if SPI_MONITOR_ASPEED
	select ASPEED_STATE_MACHINE_SHELL

config PROVISION_SHELL
	depends on PFR_DEBUG_SHELL
	bool "Enable provision debug shell for development"
	default n
	help
	  provision debug shell command

config ASPEED_STATE_MACHINE_EVENT_STEPPING
	depends on ASPEED_STATE_MACHINE_SHELL
	bool "Event stepping for state machine"
	default n

source "Kconfig.zephyr"
