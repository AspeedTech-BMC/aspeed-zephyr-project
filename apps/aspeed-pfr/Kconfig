config ASPEED_DC_SCM
	default n
	bool "ASPEED DC-SCM board"
	help
	  Enable ASPEED DC-SCM board basic settings.

config BOARD_AST2700_DCSCM_FAMILY
	bool
	default y if BOARD_AST2700_DCSCM || BOARD_AST2700_DCSCM_BHS || BOARD_AST2700_DCSCM_OKS
	help
	  Selected by AST2700 DCSCM-family boards that share the same MCTP
	  topology (BMC bridges CPU MCTP-over-I3C to PFR, PCH on I2C bus 5).
	  New family members should be added to this symbol's default
	  expression instead of editing source `#if` chains.

config SPI_NOR_INIT_PRIORITY
	# AST1080 spi0/spi1 CS nodes depend on their spim monitor
	# (spi-monitor-ctrl) via check_init_priorities.py; the aspeed spim
	# driver's init priority (81) is above the default here (80).
	default 90 if BOARD_AST1080_DCSCM_BHS || BOARD_AST1080_DCSCM_OKS

config BMC_DUAL_FLASH
	default n
	bool "Enable BMC dual flash support"
	help
	  Enable if BMC has dual flash

config CPU_DUAL_FLASH
	default n
	bool "Enable CPU dual flash support"
	help
	  Enable if CPU has dual flash

config INTEL_PFR
	default y
	bool "intel pfr solution"
	help
	  Intel PFR support

config CERBERUS_PFR
	depends on !INTEL_PFR
	default n
	bool "cerberus pfr solution"
	help
	  Cerberus PFR support

config INTEL_PFR_UNSAFE_BYPASS
	depends on INTEL_PFR
	select HROT_HASH_MBEDTLS_BYPASS
	default n
	bool "INSECURE: skip Intel PFR signature/hash verification"
	help
	  INSECURE - debug/bring-up only. Skips the root-key hash, CSK/
	  Block0 signature, and PC-hash checks in the Intel PFR active/
	  recovery verification flow, so unsigned or corrupted images boot
	  without authentication. Selects HROT_HASH_MBEDTLS_BYPASS too,
	  since computing real hashes just to ignore the comparison is
	  pointless. Never enable for production.

config SPI_MUX_INVERSE
	default n
	bool "Invert SPI MUX"
	help
	  Enable if SPI MUX connected to BMC/ROT is inverted

config ASPEED_STATE_MACHINE_SHELL
	default n
	bool "Aspeed State Machine Shell"
	help
	  Enable if user need debug shell to interact with state machine

config ASPEED_DICE
	default n
	bool "Aspeed DICE implementation"
	help
	  Enable DICE (Device Identifier Composition Engine) feature for
	  hardware root of trust and attestation support.

config ASPEED_DICE_SHELL
	default n
	bool "Aspeed DICE Shell"
	help
	  Enable if user want to test ASPEED DICE core layer implementation.

config ASPEED_DICE_CERT_VALID_FROM
	depends on ASPEED_DICE_SHELL
	default "20221010000000"
	string "Aspeed DICE certificate validity, format : YYYYMMDDhhmmss"
	help
	  Certificate not valid before this date.

config ASPEED_DICE_CERT_VALID_TO
	depends on ASPEED_DICE_SHELL
	default "20421010000000"
	string "Aspeed DICE certificate validity, format : YYYYMMDDhhmmss"
	help
	  Certificate not valid after this date.

config ASPEED_DICE_CERT_DEVID_ISSUER_NAME
	depends on ASPEED_DICE_SHELL
	default "CN=Aspeed PFR R00t,O=AST_TW,C=TW"
	string "Aspeed DICE devid certificate issuer name"
	help
	  Name of the certification authority which issued the device id certificate.

