/ {
	obmf_lstp: obmf-lstp {
		compatible = "aspeed,obmf-lstp";
		uart-controller = <&uart3>;
		uart-channel-name = "UART3";
		status = "okay";
	};
};

&fmc {
	status = "okay";
};

&fmc_cs0 {
	status = "okay";
	spi-max-buswidth = <4>;
	spi-max-frequency = <50000000>;

	partitions {
		compatible = "fixed-partitions";
		#address-cells = <1>;
		#size-cells = <1>;
		slot0_partition: partition@0 {
			label = "image-0";
			reg = <0x0 0x100000>;
		};
	};
};

&i2c0 {
	status = "okay";
	label = "I2C_0";
	clock-frequency = <1000000>;
};

&i2c1 {
	status = "okay";
	label = "I2C_1";
};

&i2c2 {
	status = "okay";
	label = "I2C_2";
};

&i2c3 {
	status = "okay";
	label = "I2C_3";
};

&i2c4 {
	status = "okay";
	label = "I2C_4";
};

&i2c5 {
	status = "okay";
	label = "I2C_5";
};

&i2c6 {
	status = "okay";
	label = "I2C_6";
};

&i2c7 {
	status = "okay";
	label = "I2C_7";
};

&wdt0 {
	status = "okay";
};

&wdt1 {
	status = "okay";
};

&wdt2 {
	status = "okay";
};

&wdt3 {
	status = "okay";
};

&wdt4 {
	status = "okay";
};

&sgpiom {
	status = "okay";
	aspeed,bus-freq = <1000>;

	sgpiom_a_d {
		status = "okay";
	};
	sgpiom_e_h {
		status = "okay";
	};
	sgpiom_i_l {
		status = "okay";
	};
	sgpiom_m_p {
		status = "okay";
	};
};

&spi1 {
	status = "okay";
};

&spi1_cs0 {
	status = "okay";
	spi-max-buswidth = <4>;
	spi-max-frequency = <50000000>;
};

&spi1_cs1 {
	status = "okay";
	spi-max-buswidth = <4>;
	spi-max-frequency = <50000000>;
};

&spi2 {
	status = "okay";
};

&spi2_cs0 {
	status = "okay";
	spi-max-buswidth = <4>;
	spi-max-frequency = <50000000>;
};

&spi2_cs1 {
	status = "okay";
	spi-max-buswidth = <4>;
	spi-max-frequency = <50000000>;
};

&uart3 {
	status = "okay";
};
