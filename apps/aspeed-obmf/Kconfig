config OBMF_ESPI_BRIDGE
	bool "OBMF eSPI bridge extension"
	default y
	depends on ESPI && ESPI_OOB_CHANNEL && ESPI_OOB_CHANNEL_RX_ASYNC
	depends on ESPI_TAF
	# The bridge calls the v2 OOB/perif API and registers a snoop callback.
	depends on ESPI_ASPEED_V2 && SNOOP_ASPEED
	depends on DT_HAS_ASPEED_ESPI_AST1040_ENABLED
	help
	  Enable the AST1040-only eSPI bridge services. The OOB bridge requires
	  asynchronous RX so it can be the channel's sole receive owner, and
	  the SAFS flash behind the MMIO window needs TAF. Direct LSTP
	  peripheral channels do not depend on this extension.

config OBMF_ESPI_MMIO
	bool "Expose the eSPI MMIO extension channel"
	default y
	depends on OBMF_ESPI_BRIDGE
	help
	  Add the MMIO channel described by the aspeed,obmf-lstp topology.

config OBMF_ESPI_MMIO_RESET
	bool "Allow the host to reboot the AST1040 over the MMIO channel"
	depends on OBMF_ESPI_MMIO
	select REBOOT
	help
	  Lets the host cold-reboot the AST1040 by writing offset 0xFFFFFFFC
	  with no data. There is no authorization: any USB host speaking LSTP
	  can trigger it. Rejected when disabled.

config OBMF_ESPI_MMIO_SAFS_WRITE
	bool "Allow the host to write the emulated SAFS flash over MMIO"
	depends on OBMF_ESPI_MMIO
	help
	  Lets the host load the RAM-backed SAFS flash that the eSPI host
	  boots from, through MMIO writes at offset 0x10000 and above. There
	  is no authorization: any USB host speaking LSTP can rewrite it.
	  Reads stay available; writes are rejected when disabled.

config OBMF_ESPI_IPMI
	bool "Expose the eSPI MMBI IPMI extension channel"
	default n
	depends on OBMF_ESPI_BRIDGE
	help
	  Bridge Host eSPI MMBI IPMI commands to AST2700 LSTP IPMI Channel.

config OBMF_ESPI_UART_VUART
	bool "Bridge Host 0x3F8 through the hardware VUART0"
	depends on OBMF_ESPI_BRIDGE
	depends on $(dt_nodelabel_enabled,vuart0)
	default y
	help
	  Serve the LSTP UART channel from the AST1040 hardware VUART0 at
	  0x74c30000, which claims Host eSPI port 0x3F8 with a full
	  bidirectional FIFO on SerIRQ 4 (src/uart/lstp_uart_vuart.c).

	  Turning this off does not disable the UART channel -- it is always
	  exported. It selects src/uart/lstp_uart_plain.c instead, which
	  drives the ordinary UART named by the aspeed,obmf-lstp
	  uart-controller phandle (AST1030), or the shell backend when
	  CONFIG_OBMF_LSTP_UART_SHELL is set.

menu "OBMF LSTP peripheral channels"

config OBMF_LSTP_SPI_CHANNEL
	bool "Export the LSTP SPI channel"
	default y
	depends on FLASH_JESD216_API && FLASH_PAGE_LAYOUT
	help
	  Export the SPI flash listed in the aspeed,obmf-lstp topology
	  (spi-devices takes exactly one) as a read-only LSTP SPI channel.
	  The BMC's opcodes are served through the flash API (JEDEC ID, SFDP
	  and the 03h/13h/0Bh/0Ch reads); nothing is driven on the SPI bus
	  directly.

config OBMF_LSTP_MTD_CLIENT
	bool "Remote MTD client over LSTP SPI"
	default n
	depends on OBMF_LSTP_SPI_CHANNEL
	help
	  Enable firmware-initiated access to the peer's SPI flash and, with
	  CONFIG_SHELL, the "obmf mtd" commands.
	  Disabled by default because any shell user can program and erase the
	  peer's flash when this client is enabled.

config OBMF_LSTP_I2C_CHANNEL
	bool "Export the LSTP I2C channel"
	default y
	depends on I2C
	help
	  Export the I2C controller named by the aspeed,obmf-lstp topology as an
	  LSTP I2C channel. When disabled the BMC no longer registers an I2C
	  adapter for this device.

config OBMF_LSTP_UART_SHELL
	bool "Back the LSTP UART channel with shell commands"
	depends on SHELL && !OBMF_ESPI_UART_VUART
	help
	  Serve the LSTP UART channel with no UART behind it
	  (src/uart/lstp_uart_shell.c). What the BMC writes to its ttyLSTP is
	  kept for "obmf uart recv", and "obmf uart send" writes a
	  line back. The topology then needs no uart-controller.

config OBMF_LSTP_GPIO_CHANNEL
	bool "Export the LSTP GPIO channel"
	default y
	depends on GPIO
	help
	  Export the GPIO banks and eSPI virtual wires named by the
	  aspeed,obmf-lstp topology as an LSTP GPIO channel. When disabled no
	  GPIO IRQ events are forwarded and the BMC registers no gpiochip.

endmenu

source "Kconfig.zephyr"
