&fmc {
	status = "okay";
};

&fmc_cs0 {
	status = "okay";
	spi-max-buswidth = <4>;
	spi-max-frequency = <50000000>;

	partitions {
		compatible = "fixed-partitions";
		#address-cells = <1>;
		#size-cells = <1>;
		slot0_partition: partition@0 {
			label = "image-0";
			reg = <0x0 0x100000>;
		};
		slot1_partition: partition@1 {
		       label = "image-1";
		       reg = <0x0 0x100000>;
	       };
	};
};

&i2c0 {
	status = "okay";
	label = "I2C_0";
	clock-frequency = <1000000>;
};

&i2c1 {
	status = "okay";
	label = "I2C_1";
};

&i2c2 {
	status = "okay";
	label = "I2C_2";
};

&i2c3 {
	status = "okay";
	label = "I2C_3";
};

&i2c4 {
	status = "okay";
	label = "I2C_4";
